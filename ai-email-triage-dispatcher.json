        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"requires_response\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if the email requires a response based on the business rules, otherwise false.\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"new_order\",\n        \"order_status\",\n        \"delivery_inquiry\",\n        \"complaint\",\n        \"ignore\"\n      ],\n      \"description\": \"The exact category of the email.\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"A brief 1-sentence summary of the customer's email.\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of why this email does or does not require a response.\"\n    }\n  },\n  \"required\": [\n    \"requires_response\",\n    \"category\",\n    \"summary\",\n    \"reason\"\n  ],\n  \"additionalProperties\": false\n}"
